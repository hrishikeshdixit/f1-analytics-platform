        ROUND(AVG(speed_longest_straight), 1)       AS avg_speed_longest_straight

    FROM laps
    WHERE lap_time_seconds IS NOT NULL
    GROUP BY driver_code, driver_number, team
)

SELECT * FROM driver_stats
    );
  
